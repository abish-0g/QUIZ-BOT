# Copy this to .env and fill in your values

# Required
BOT_TOKEN=your_bot_token_here

# Optional: Comma-separated Telegram user IDs of super admins
# If empty, anyone can add questions via DM
SUPER_ADMINS=123456789,987654321

# Database (default: local SQLite)
DATABASE_URL=sqlite+aiosqlite:///quiz_bot.db

# Quiz settings
QUESTION_TIMER=20       # seconds per question
BETWEEN_DELAY=3         # seconds between questions
